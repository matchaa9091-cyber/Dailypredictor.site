{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "daily-predictor",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "daily-predictor-db",
			"database_id": "2d89927b-c0b7-4fdb-8cf3-fbfe3cd15b21"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "daily-predictor-storage"
		}
	]
}
